<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/assignment_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/assignment_widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="待完成作业"
        android:textColor="#526159"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/assignment_title_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#17211D"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/assignment_meta_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#526159"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/assignment_title_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#17211D"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/assignment_meta_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="#526159"
        android:textSize="12sp" />
</LinearLayout>
